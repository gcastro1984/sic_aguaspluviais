{
    "cliente": "Postman",
    "info": {
        "name": "Infraestrutura Urbana API - Collection de Testes",
        "description": "Testes completos para a API de Infraestruturas Urbanas",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "baseUrl": "http://localhost:3001",
    "requests": [
        {
            "name": "1. Criar Infraestrutura - Coletor Principal",
            "method": "POST",
            "url": "{{baseUrl}}/infraestruturas",
            "headers": {
                "Content-Type": "application/json"
            },
            "body": {
                "mode": "raw",
                "raw": "{\n  \"nome\": \"Coletor Principal - Zona Ribeirinha\",\n  \"tipo\": \"coletor_pluvial\",\n  \"localizacao\": \"Vila do Conde - Marginal e Rio Ave\",\n  \"idarea_risco\": 1\n}"
            }
        },
        {
            "name": "2. Criar Infraestrutura - Coletor Secundário",
            "method": "POST",
            "url": "{{baseUrl}}/infraestruturas",
            "headers": {
                "Content-Type": "application/json"
            },
            "body": {
                "mode": "raw",
                "raw": "{\n  \"nome\": \"Coletor Secundário - Passagem Inferior\",\n  \"tipo\": \"coletor_pluvial\",\n  \"localizacao\": \"Vila do Conde - Acesso rodoviário inferior\",\n  \"idarea_risco\": 2\n}"
            }
        },
        {
            "name": "3. Criar Infraestrutura - Rede de Drenagem",
            "method": "POST",
            "url": "{{baseUrl}}/infraestruturas",
            "headers": {
                "Content-Type": "application/json"
            },
            "body": {
                "mode": "raw",
                "raw": "{\n  \"nome\": \"Rede de Drenagem Centro\",\n  \"tipo\": \"rede_drenagem\",\n  \"localizacao\": \"Vila do Conde - Centro\",\n  \"idarea_risco\": 3\n}"
            }
        },
        {
            "name": "4. Listar Todas as Infraestruturas",
            "method": "GET",
            "url": "{{baseUrl}}/infraestruturas",
            "headers": {}
        },
        {
            "name": "5. Obter Infraestrutura por ID",
            "method": "GET",
            "url": "{{baseUrl}}/infraestruturas/1",
            "headers": {}
        },
        {
            "name": "6. Filtrar por Área de Risco",
            "method": "GET",
            "url": "{{baseUrl}}/infraestruturas/area/1",
            "headers": {}
        },
        {
            "name": "7. Filtrar por Tipo - Coletor Pluvial",
            "method": "GET",
            "url": "{{baseUrl}}/infraestruturas/tipo/coletor_pluvial",
            "headers": {}
        },
        {
            "name": "8. Filtrar por Tipo - Rede Drenagem",
            "method": "GET",
            "url": "{{baseUrl}}/infraestruturas/tipo/rede_drenagem",
            "headers": {}
        },
        {
            "name": "9. Atualizar Tipo de Infraestrutura",
            "method": "PUT",
            "url": "{{baseUrl}}/infraestruturas/1",
            "headers": {
                "Content-Type": "application/json"
            },
            "body": {
                "mode": "raw",
                "raw": "{\n  \"tipo\": \"coletor_principal\"\n}"
            }
        },
        {
            "name": "10. Atualizar Localização",
            "method": "PUT",
            "url": "{{baseUrl}}/infraestruturas/1",
            "headers": {
                "Content-Type": "application/json"
            },
            "body": {
                "mode": "raw",
                "raw": "{\n  \"localizacao\": \"Vila do Conde - Marginal e Rio Ave (Atualizado)\"\n}"
            }
        },
        {
            "name": "11. Deletar Infraestrutura",
            "method": "DELETE",
            "url": "{{baseUrl}}/infraestruturas/1",
            "headers": {}
        },
        {
            "name": "12. Teste - Campo Obrigatório Faltando",
            "method": "POST",
            "url": "{{baseUrl}}/infraestruturas",
            "headers": {
                "Content-Type": "application/json"
            },
            "body": {
                "mode": "raw",
                "raw": "{\n  \"nome\": \"Teste\",\n  \"tipo\": \"coletor\",\n  \"localizacao\": \"Local\"\n}"
            }
        },
        {
            "name": "13. Teste - Área Risco Inválida",
            "method": "POST",
            "url": "{{baseUrl}}/infraestruturas",
            "headers": {
                "Content-Type": "application/json"
            },
            "body": {
                "mode": "raw",
                "raw": "{\n  \"nome\": \"Teste\",\n  \"tipo\": \"coletor\",\n  \"localizacao\": \"Local\",\n  \"idarea_risco\": 9999\n}"
            }
        },
        {
            "name": "14. Obter Infraestrutura Inexistente",
            "method": "GET",
            "url": "{{baseUrl}}/infraestruturas/9999",
            "headers": {}
        },
        {
            "name": "15. Filtrar por Área Inexistente",
            "method": "GET",
            "url": "{{baseUrl}}/infraestruturas/area/9999",
            "headers": {}
        },
        {
            "name": "16. Filtrar por Tipo Inexistente",
            "method": "GET",
            "url": "{{baseUrl}}/infraestruturas/tipo/tipo_inexistente",
            "headers": {}
        }
    ]
}